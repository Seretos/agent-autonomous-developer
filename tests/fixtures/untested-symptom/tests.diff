+const fs = require("fs");
+const path = require("path");
+
+describe("browser bootstrap (R1)", () => {
+  test("browser-tool.js calls ensureBrowserInstalled before navigating", () => {
+    const src = fs.readFileSync(
+      path.join(__dirname, "..", "src", "browser-tool.js"),
+      "utf8"
+    );
+    expect(src).toContain("ensureBrowserInstalled(");
+  });
+
+  test("install.js exports ensureBrowserInstalled", () => {
+    const install = require("../src/install.js");
+    expect(typeof install.ensureBrowserInstalled).toBe("function");
+  });
+});
